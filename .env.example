# Alpaca paper trading credentials (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# Symbol to trade
SYMBOL=AAPL

# Base hourly profit target in dollars, scaled by account equity at runtime
BASE_PROFIT_TARGET=1.0

# SMA crossover windows (number of ticks/bars)
SHORT_WINDOW=5
LONG_WINDOW=20
