# Alpaca paper trading credentials
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

SYMBOL=AAPL
BASE_PROFIT_TARGET=1.0
SHORT_WINDOW=5
LONG_WINDOW=20

# Safety: paper trading stays on unless you explicitly set PAPER=false
PAPER=true

# Persist meta weights + daily risk-gate across process restarts
# STATE_PATH=state.json

# Simulated fill slippage in basis points (dry-run / backtest only)
# SLIP_BPS=0
